# Copy thành .env rồi sửa giá trị trước khi `docker compose up -d --build`

# Bắt buộc
JWT_SECRET=doi-chuoi-ngau-nhien-dai-va-bi-mat
ADMIN_EMAIL=anthutechnology@gmail.com
ADMIN_PASSWORD=doi-mat-khau-manh

# Server Ollama của anh (đã setup sẵn). Nếu Ollama chạy ngay trên host này thì giữ nguyên.
OLLAMA_URL=http://host.docker.internal:11434

# Tùy chọn
POSTGRES_PASSWORD=edutech
MAX_CONCURRENT_JOBS=2
DEFAULT_MODEL=qwen3:8b
# URL công khai của backend mà TRÌNH DUYỆT người dùng gọi tới (đổi khi deploy ra server thật)
PUBLIC_API_URL=http://localhost:8080

# Giới hạn ký tự văn bản nguồn (spec mục 2c). Đếm theo KÝ TỰ, không phải byte.
MIN_SOURCE_CHARS=50
MAX_SOURCE_CHARS=20000

# --- Google Forms (TUỲ CHỌN, spec mục 2b) ---
# Thiếu ba biến này thì chỉ nút "Xuất Google Forms" bị tắt, mọi thứ khác chạy bình thường.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/google/callback
# Khoá mã hoá refresh token Google trong DB. ĐỔI KHOÁ NÀY = mọi giáo viên phải nối lại tài khoản.
TOKEN_ENCRYPTION_KEY=
# Để callback của Google quay về đúng trang Cài đặt của frontend.
FRONTEND_URL=http://localhost:3000
