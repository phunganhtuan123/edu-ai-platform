# EduTech AI backend — cấu hình môi trường (spec section 7)

# PostgreSQL connection string
DATABASE_URL=postgres://edutech:edutech@localhost:5432/edutech?sslmode=disable

# Secret ký JWT — BẮT BUỘC đổi khi chạy thật
JWT_SECRET=change-me-to-a-long-random-string

# Server Ollama riêng (không cần API key), vd http://192.168.1.10:11434
OLLAMA_URL=http://localhost:11434

# Tài khoản admin cố định, seed lần chạy đầu (role=admin, status=active)
ADMIN_EMAIL=admin@edutech.local
ADMIN_PASSWORD=change-me-strong-password

# Số job Ollama chạy đồng thời tối đa (mặc định 2)
MAX_CONCURRENT_JOBS=2

# Model Ollama mặc định khi client không chọn
DEFAULT_MODEL=qwen3:8b

# Cổng HTTP của backend (mặc định 8080)
PORT=8080
